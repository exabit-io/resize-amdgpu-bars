#!/bin/bash
# resize-amdgpu-bars-check — one-line verdict for a resize-amdgpu-bars boot, appended
# to a matrix log so kernels and cards can be compared. Read-only.
#
#   resize-amdgpu-bars-check        this boot (journal + live sysfs)
#   resize-amdgpu-bars-check -1     previous boot (journal only)
#
# Standalone for now; folds into "resize-amdgpu-bars check" in a later release.
# Environment: LOG (matrix log path), RESIZE_AMDGPU_BARS_SYSFS (test-only sysfs
# root).
set -u
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

B=${1:-0}
LOG=${LOG:-/var/log/resize-amdgpu-bars/kernel-matrix.log}
SYSFS=${RESIZE_AMDGPU_BARS_SYSFS:-/sys}
TOOL=/usr/sbin/resize-amdgpu-bars

J() { journalctl -b "$B" -u resize-amdgpu-bars.service --no-pager -o cat 2>/dev/null; }
K() { journalctl -b "$B" -k --no-pager -o cat 2>/dev/null; }

# Distinct XGMI hive ids from sysfs (one per hive, however many dies it has;
# "XGMI: Add node" journal lines double-count when the driver is reloaded).
hive_count() {
	local f id
	local -A seen=()
	for f in "$SYSFS"/bus/pci/devices/*/xgmi_hive_info/xgmi_hive_id; do
		[[ -r $f ]] || continue
		id=$(<"$f")
		[[ -n $id ]] && seen[$id]=1
	done
	echo "${#seen[@]}"
}

# KFD topology node count without parsing ls.
kfd_count() {
	local d n=0
	for d in "$SYSFS"/class/kfd/kfd/topology/nodes/*/; do
		[[ -d $d ]] && n=$((n + 1))
	done
	echo "$n"
}

kver=$(K | head -1 | sed -E 's/^Linux version ([^ ]+).*/\1/')
btime=$(journalctl -b "$B" --no-pager -o short-iso 2>/dev/null | head -1 | cut -c1-19)
plan=$(J | sed -n 's/.*Plan achieved *: *//p' | tail -1)
large=$(J | sed -n 's/.*Large BARs *: *//p' | tail -1 | tr -d ' ')
drvless=$(J | sed -n 's/.*Driverless *: *//p' | tail -1 | tr -d ' ')
success=$(J | grep -c 'SUCCESS:')
rejected=$(J | grep -c 'rejected')
traces=$(K | grep -cE 'Call Trace|BUG:|Oops|hung task|blocked for more than')
sriov=$(K | grep -cE 'trn=2 ACK|MCBP is enabled')
losers=$(J | grep -o 'unassigned BARs on: .*' | head -1)

if [[ $B == 0 ]]; then
	status=$("$TOOL" status 2>/dev/null || true)
	bar0=$(grep -oE 'bar0=[^,]+' <<<"$status" | cut -d= -f2 | tr '\n' ' ')
	wins=""
	while read -r r; do
		[[ -z $r || $r == none ]] && continue
		w=$(lspci -vvs "$r" 2>/dev/null | sed -n 's/.*Prefetchable memory behind bridge: .*\[size=\([^]]*\)\].*/\1/p')
		wins+="$r=${w:-?} "
	done < <(grep -oE 'root=[^ ]+' <<<"$status" | cut -d= -f2 | sort -u)
	kfd=$(kfd_count)
	hives=$(hive_count)
else
	bar0="(live only)"; wins="(live only)"; kfd="(live only)"; hives="(live only)"
fi

case "$plan:$success" in
	all-max:1)     verdict="WORKS" ;;
	none:*)        verdict="FAILS (bind guard held)" ;;
	none-needed:*) verdict="NO RESIZABLE GPU" ;;
	*)             verdict="OTHER - inspect" ;;
esac
(( traces > 0 || sriov > 0 )) && verdict="$verdict + TRACE/SRIOV NOISE - inspect"

line="$btime  $kver  verdict=$verdict  plan=${plan:-?}  large=${large:-?}  driverless=${drvless:-?}  windows=${wins% }  bar0=${bar0:-?}  kfd=$kfd  xgmi_hives=$hives  traces=$traces  rejected=$rejected  ${losers}"
echo "$line"
if [[ $B == 0 ]]; then
	mkdir -p "$(dirname "$LOG")"
	echo "$line" >> "$LOG"
	echo "(appended to $LOG)"
fi
