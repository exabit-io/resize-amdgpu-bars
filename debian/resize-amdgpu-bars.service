# resize-amdgpu-bars.service — installed by the resize-amdgpu-bars package.
#
# Enlarges the Resizable BAR of every AMD GPU the amdgpu driver handles,
# re-enumerates only the all-GPU PCI subtrees (on their own root bus) so the
# kernel re-sizes the bridge windows above them, then loads amdgpu once,
# behind a bind guard that never hands the driver a device whose BAR did
# not come back.
#
# Needs, both effective from the next boot:
#   /usr/lib/modprobe.d/resize-amdgpu-bars.conf   keeps amdgpu from autoloading
#                                              before this unit has run
#   pci=realloc on the kernel command line     /etc/default/grub.d/resize-amdgpu-bars.cfg
#
# Exit status: 0 every GPU resized and bound; 2 degraded, the bind guard is
# holding one or more GPUs back from the driver (counted as success below so
# boot proceeds on whatever came up; the journal and "resize-amdgpu-bars status"
# carry the detail); 1 error.
#
# Verify:  journalctl -b -u resize-amdgpu-bars.service
#          resize-amdgpu-bars status

[Unit]
Description=Resizable BAR for AMD GPUs behind PCIe switches
Documentation=man:resize-amdgpu-bars(8) man:resize-amdgpu-bars.conf(5)
DefaultDependencies=no
Requires=local-fs.target sysinit.target systemd-udevd.service
After=sysinit.target local-fs.target systemd-udevd.service systemd-modules-load.service
Before=display-manager.service graphical.target multi-user.target
# The tool never modprobes a GPU whose BAR failed to assign (driver_override
# = none first); handing amdgpu such a device hangs the boot in D state.
Before=modprobe@amdgpu.service
Wants=systemd-udevd.service
FailureAction=none

[Service]
Type=oneshot
# The tool waits for the GPU sysfs nodes itself; no udevadm settle here (it
# timed out every boot behind a slow platform driver and the failure line
# looked like a stalled boot).
ExecStart=/usr/sbin/resize-amdgpu-bars resize --force
RemainAfterExit=yes
# 2 = degraded (bind guard holding); the boot is not marked failed, and
# monitoring can still tell it from 0 via ExecMainStatus.
SuccessExitStatus=2
# Budget: discovery + up to MAX_ROUNDS re-enumeration cycles (~10 s each) +
# bounded modprobe (180 s + 30 s kill) + PROBE_WAIT 60 s + margin. Must stay
# larger than MODPROBE_TIMEOUT + PROBE_WAIT in resize-amdgpu-bars.conf(5).
TimeoutStartSec=480

# --- privileges -----------------------------------------------------------
# CAP_SYS_ADMIN: sysfs unbind/remove/rescan and config-space writes;
# CAP_SYS_RAWIO: setpci; CAP_SYS_MODULE: modprobe amdgpu.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_SYS_MODULE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_SYS_MODULE
NoNewPrivileges=yes
RestrictSUIDSGID=yes
UMask=0077

# --- file system ----------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# sysfs for the PCI writes; /run/lock for the instance lock; the runtime
# directory for per-boot state (expected BAR map, last summary).
ReadWritePaths=/sys/bus/pci /sys/devices /run/lock
RuntimeDirectory=resize-amdgpu-bars
RuntimeDirectoryPreserve=yes
# Deliberately NOT set: PrivateDevices= (would hide /dev/kfd and /dev/dri,
# which appear when amdgpu loads and are what the probe wait and the
# post-load checks look at; it also strips CAP_SYS_RAWIO) and
# DevicePolicy=closed for the same reason.

# --- kernel ---------------------------------------------------------------
# Both must stay "no": the tool writes sysfs (ProtectKernelTunables) and
# loads amdgpu (ProtectKernelModules).
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectProc=invisible

# --- isolation ------------------------------------------------------------
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Not set: SystemCallFilter=@system-service @module @raw-io (score 2.9 with
# it). A wrong filter kills this unit with SIGSYS at boot, leaving amdgpu
# blacklisted and no driver loaded, and it could not be validated on real
# hardware before this release. Validate read-only, then enable it:
#   systemd-run --wait --pipe --collect --unit=rgb-sandbox-test \
#     -p SystemCallFilter='@system-service @module @raw-io' <other [Service]
#     hardening lines as -p ...> -p ReadWritePaths=/run/resize-amdgpu-bars \
#     /usr/sbin/resize-amdgpu-bars diagnose

StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=resize-amdgpu-bars

[Install]
WantedBy=multi-user.target
